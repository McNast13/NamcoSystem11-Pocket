# Full System 11 core (SYSTEM11.sv + Pocket shell). The core tree is generated by tools/build_core_tree.py into pocket/build/core_tree.
set s11_core_qip ../core/core_full.qip
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
source s11.qsf
