#!/usr/bin/env python3
"""Lean game builds: use with S11_SKIP=s11_bootbits (the bring-up probe export is left out to free area) and S11_PROBES=s11_dbg2_zero.
Without s11_bootbits the s11_boot_dbg bus does not exist, so the PK_DBG2 assign written by pocket_emu.apply is tied to zero instead
(diagnostic rows 1 and 4-9 then read 0). Run AFTER pocket_emu.apply. Usage: s11_dbg2_zero.apply OUTDIR
"""
import sys
from pathlib import Path

p = Path(sys.argv[1]) / "SYSTEM11.sv"
t = p.read_text()
assert "wire [287:0] s11_boot_dbg;" not in t, "s11_bootbits is applied: skip it (S11_SKIP=s11_bootbits) before tying PK_DBG2 to zero"
old = "assign PK_DBG2 = s11_boot_dbg;"
assert t.count(old) == 1, t.count(old)
p.write_text(t.replace(old, "assign PK_DBG2 = 288'd0;   // s11_dbg2_zero.apply: lean build without s11_bootbits"))
print("PK_DBG2 tied to zero")
