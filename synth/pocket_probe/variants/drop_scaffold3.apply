#!/usr/bin/env python3
"""Third batch: the debug text overlay (gpu_overlay) and hps_io's video_calc (resolution readout for MiSTer's OSD)."""
import re, sys
from pathlib import Path

work = Path(sys.argv[1]).resolve()

p = work / "rtl/gpu_overlay.vhd"
t = p.read_text()
ent = t[: re.search(r"\nend entity;", t).end()]
p.write_text(ent + """

architecture stub of gpu_overlay is
begin
   o_pixel_out_data <= (others => '0');
   o_pixel_out_ena  <= '0';
end architecture;
""")

p = work / "sys/hps_io.sv"
t = p.read_text()
m = re.search(r"\bmodule\s+video_calc\b.*?\bendmodule\b", t, re.S)
head = m.group(0)[: m.group(0).index(");") + 2]
p.write_text(t[: m.start()] + head + "\n  always @* dout = 16'd0;\nendmodule" + t[m.end():])
print("stubbed gpu_overlay, video_calc")
