#!/usr/bin/env python3
"""Bring-up probe: export the MiSTer core's boot-progress latches and the last I/O read address through psx_top -> psx_mister -> SYSTEM11.sv
as one 64-bit port s11_boot_dbg (the latches are the MiSTer author's own boot milestones; nothing else changes).
  [63:32] bits: 31 pc_reached_mid 30 pc_reached_gpuinit 29 m_gpuinit 28 m_strcmp 27 m_strfail 26 m_launch 25 m_decomp2 24 s11_reached_game
                23 rch_kernel(0xBFC00484 kernel copy) 22 rch_initheap(0x8004xxxx) 21 rch_b0handler(0x8005xxxx) 20 rch_decomp(0x8001xxxx game entry)
                19 helper_entry_seen 18 panic_reached 17 gpu_accessed_seen 16 pio_prim_seen 15 dma2_prim_seen 14 raster_pixel_seen
                13 imask0_write_seen 12 istat_ack_seen 11 vblank_irq_seen 10 irqreq_seen 9 io_ever_seen 8 spu_ever_seen 7 cd_ever_seen
                6 dma_ever_seen 5 dma_gpu_write_seen 4:0 zero
  [31:0]  dbg_last_io_rd (last CPU data read in the hardware/IO range = the poll target when waiting on a register)
Usage: s11_bootbits.apply OUTDIR [ignored...]
"""
import sys
from pathlib import Path

out = Path(sys.argv[1])

def sub(path, old, new):
    t = path.read_text()
    assert t.count(old) == 1, (path.name, old, t.count(old))
    path.write_text(t.replace(old, new))

top = out / "rtl/psx_top.vhd"
sub(top, "      dbg_reached_game : out std_logic := '0';  -- MIPS reached game code -> top-level overlay auto-hide\n",
         "      dbg_reached_game : out std_logic := '0';  -- MIPS reached game code -> top-level overlay auto-hide\n"
         "      s11_boot_dbg    : out std_logic_vector(287 downto 0) := (others => '0');  -- bring-up probe (s11_bootbits.apply)\n")
sub(top, "   dbg_reached_game <= s11_reached_game;",
         "   s11_boot_dbg <= (pc_reached_mid & pc_reached_gpuinit & m_gpuinit & m_strcmp & m_strfail & m_launch & m_decomp2 & s11_reached_game &\n"
         "                    rch_kernel & rch_initheap & rch_b0handler & rch_decomp & helper_entry_seen & panic_reached & gpu_accessed_seen & pio_prim_seen &\n"
         "                    dma2_prim_seen & raster_pixel_seen & imask0_write_seen & istat_ack_seen & vblank_irq_seen & irqreq_seen & io_ever_seen & spu_ever_seen &\n"
         "                    cd_ever_seen & dma_ever_seen & dma_gpu_write_seen & std_logic_vector'(\"00000\")) & std_logic_vector(cpu_dbg_exc_epc) & std_logic_vector(cpu_dbg_exc_code) & std_logic_vector'(\"000\" & lowsled_seen) & std_logic_vector(cpu_dbg_fault_addr(23 downto 0)) & dbg_last_ram_pc & std_logic_vector(cpu_dbg_fault_ra) & s11_ce_l & std_logic_vector(cpu_dbg_fault_a1) & s11_dr_l & s11_pa_l;\n"
         "   dbg_reached_game <= s11_reached_game;")

sub(top, "   signal dbg_last_io_rd         : std_logic_vector(31 downto 0) := (others => '0');",
         "   signal s11_last_rd_any       : std_logic_vector(31 downto 0) := (others => '0');  -- bring-up probe: last CPU data read, any region\n"
         "   signal s11_win : unsigned(24 downto 0) := (others => '0');\n"
         "   signal s11_ce_c, s11_if_c, s11_dr_c, s11_pa_c : unsigned(31 downto 0) := (others => '0');\n"
         "   signal s11_ce_l, s11_if_l, s11_dr_l, s11_pa_l : std_logic_vector(31 downto 0) := (others => '0');\n"
         "   signal dbg_last_io_rd         : std_logic_vector(31 downto 0) := (others => '0');")
sub(top, "            if mem_request = '1' and mem_isData = '1' and mem_rnw = '0' then\n               dbg_last_wr_addr",
         "            if mem_request = '1' and mem_isData = '1' and mem_rnw = '1' then\n"
         "               s11_last_rd_any <= std_logic_vector(mem_addressData);\n"
         "            end if;\n"
         "            if mem_request = '1' and mem_isData = '1' and mem_rnw = '0' then\n               dbg_last_wr_addr")

sub(top, "\nend architecture;",
         "\n   -- bring-up probe: per-window (2^25 clk1x = ~1 s) counts of CPU clock enables, instruction-fetch requests, data requests and paused cycles\n"
         "   s11_rate_proc : process (clk1x)\n"
         "   begin\n"
         "      if rising_edge(clk1x) then\n"
         "         s11_win <= s11_win + 1;\n"
         "         if cache_wr(0) = '1' and cache_data = x\"00000000\" then s11_ce_c <= s11_ce_c + 1; end if;   -- instruction-cache line fills of an all-zero word (NOP sled?)\n"
         "         if mem_request = '1' and mem_isData = '0' then s11_if_c <= s11_if_c + 1; end if;\n"
         "         if cache_wr(0) = '1' and cache_data /= x\"00000000\" then s11_dr_c <= s11_dr_c + 1; s11_pa_l <= cache_data; end if;   -- non-zero fills; last non-zero first-word\n"
         "         if pausing = '1' or cpuPaused = '1' then s11_pa_c <= s11_pa_c + 1; end if;\n"
         "         if s11_win = 0 then\n"
         "            s11_ce_l <= std_logic_vector(s11_ce_c); s11_if_l <= std_logic_vector(s11_if_c);\n"
         "            s11_dr_l <= std_logic_vector(s11_dr_c);\n"
         "            s11_ce_c <= (others => '0'); s11_if_c <= (others => '0'); s11_dr_c <= (others => '0'); s11_pa_c <= (others => '0');\n"
         "         end if;\n"
         "      end if;\n"
         "   end process;\nend architecture;")

mis = out / "rtl/psx_mister.vhd"
sub(mis, "      dbg_reached_game : out std_logic := '0';  -- MIPS reached game code (overlay auto-hide)\n",
         "      dbg_reached_game : out std_logic := '0';  -- MIPS reached game code (overlay auto-hide)\n"
         "      s11_boot_dbg    : out std_logic_vector(287 downto 0) := (others => '0');\n")
sub(mis, "      dbg_reached_game => dbg_reached_game,\n",
         "      dbg_reached_game => dbg_reached_game,\n      s11_boot_dbg => s11_boot_dbg,\n")

sv = out / "SYSTEM11.sv"
sub(sv, "   .dbg_reached_game(dbg_reached_game),", "   .s11_boot_dbg(s11_boot_dbg),\n   .dbg_reached_game(dbg_reached_game),")
sub(sv, "wire        dbg_reached_game; // MIPS reached game code (from psx_mister) -> overlay auto-hide",
        "wire        dbg_reached_game; // MIPS reached game code (from psx_mister) -> overlay auto-hide\nwire [287:0] s11_boot_dbg;     // bring-up probe (s11_bootbits.apply)")
print("s11_bootbits: boot-progress latches + last IO read exported as s11_boot_dbg")
