#!/usr/bin/env python3
"""Replace MiSTer-only scaffolding with idle stubs: the savestate engine (reset passes through)
and the runtime PLL reconfiguration core. Measures what the Pocket shell would not need."""
import re, sys
from pathlib import Path

work = Path(sys.argv[1]).resolve()

# savestates: same entity, no state saving. reset_out must still follow reset_in.
p = work / "rtl/savestates.vhd"
text = p.read_text()
ent = re.search(r"entity savestates is.*?\nend entity;", text, re.S).group(0)
stub = f"""library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.numeric_std.all;

{ent}

architecture stub of savestates is
begin
   reset_out         <= reset_in;
   validSStates      <= (others => '0');
   savestate_busy    <= '0';
   SS_wren           <= (others => '0');
   SS_rden           <= (others => '0');
end architecture;
"""
p.write_text("-- stub: savestates removed for the Pocket area probe\n" + stub)

(work / "pll_cfg_stub.v").write_text("""module pll_cfg(
  input mgmt_clk, input mgmt_reset, output mgmt_waitrequest, input mgmt_read,
  output [31:0] mgmt_readdata, input mgmt_write, input [5:0] mgmt_address,
  input [31:0] mgmt_writedata, output [63:0] reconfig_to_pll, input [63:0] reconfig_from_pll);
  assign mgmt_waitrequest = 1'b0;
  assign mgmt_readdata = 32'd0;
  assign reconfig_to_pll = 64'd0;
endmodule
""")
print("stubbed savestates and pll_cfg")
