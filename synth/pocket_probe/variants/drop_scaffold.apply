#!/usr/bin/env python3
"""Replace MiSTer-only scaffolding with idle stubs: the runtime PLL reconfiguration core (the savestate engine was
stubbed here too until 2026-10-22; see savestates_reset_only.apply). Measures what the Pocket shell would not need."""
import re, sys
from pathlib import Path

work = Path(sys.argv[1]).resolve()

# savestates: NOT stubbed any more. The stub never pulsed ss_reset, so the CPU reset to PC 0 instead of 0xBFC00000
# (2026-10-22); savestates_reset_only.apply now specializes the real sequencer.

(work / "pll_cfg_stub.v").write_text("""module pll_cfg(
  input mgmt_clk, input mgmt_reset, output mgmt_waitrequest, input mgmt_read,
  output [31:0] mgmt_readdata, input mgmt_write, input [5:0] mgmt_address,
  input [31:0] mgmt_writedata, output [63:0] reconfig_to_pll, input [63:0] reconfig_from_pll);
  assign mgmt_waitrequest = 1'b0;
  assign mgmt_readdata = 32'd0;
  assign reconfig_to_pll = 64'd0;
endmodule
""")
print("stubbed pll_cfg")
